+
+def test_ui_meta_accepts_extended_room_projection_and_rejects_oversize(home):
+    # The Desktop sync projection is bounded below this 256 KiB JSON cap.
+    large = {"hermes-bots-groups": {"rooms": {"name:Room": {"log": ["x" * 190_000]}}}}
+    assert len(json.dumps(large)) > 65_536
+    assert len(json.dumps(large)) < 262_144
+    accepted = _configure(large)
+    assert accepted["ui_meta"] is True
+    assert _default_profile()["ui_meta"]["hermes-bots-groups"] == large["hermes-bots-groups"]
+    revision = accepted["ui_meta_revisions"]["hermes-bots-groups"]
+    oversized = {"hermes-bots-groups": {"rooms": {"name:Room": {"log": ["x" * 263_000]}}}}
+    rejected = _configure(oversized, {"hermes-bots-groups": revision})
+    assert rejected["ui_meta"] is False
+    assert _default_profile()["ui_meta_revisions"]["hermes-bots-groups"] == revision
+    assert _default_profile()["ui_meta"]["hermes-bots-groups"] == large["hermes-bots-groups"]
+
+
+def test_ui_meta_gateway_cap_includes_key_wrapper_at_exact_boundary(home):
+    prefix = len(json.dumps({"hermes-bots-groups": {"log": [""]}}))
+    exact = {"hermes-bots-groups": {"log": ["x" * (262_144 - prefix)]}}
+    assert len(json.dumps(exact)) == 262_144
+    assert _configure(exact)["ui_meta"] is True
+    revision = _default_profile()["ui_meta_revisions"]["hermes-bots-groups"]
+
+    too_large = {"hermes-bots-groups": {"log": ["x" * (262_145 - prefix)]}}
+    assert len(json.dumps(too_large)) == 262_145
+    assert _configure(too_large, {"hermes-bots-groups": revision})["ui_meta"] is False
+    assert _default_profile()["ui_meta_revisions"]["hermes-bots-groups"] == revision
